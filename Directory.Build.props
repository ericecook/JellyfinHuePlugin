<Project>

  <!-- Analyzer settings for both projects. Rule severities live in .editorconfig. -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit advisories (NU1901-NU1904) stay warnings: a new advisory against a
         dependency must not fail a release build that has had no code change. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
